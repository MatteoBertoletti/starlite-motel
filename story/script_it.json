    "YOU":   { "voice": "im_nicola", "lang": "i", "speed": 0.95, "pitch": 1.06, "fx": "tape" },
    "OWNER": { "voice": "im_nicola", "lang": "i", "speed": 0.9,  "pitch": 0.84, "fx": "door" }
  },
  "anchors": {
    "slides": [2, "passa"], "rules": [2, "regole"], "hour": [11, "unora"], "phone": [12, "accende"],
    "picks": [14, "parte"], "flicker": [17, "sfarfallare"], "holds": [19, "resta"], "hits": [21, "centra"],
    "goes": [22, "spegne"], "knock": [23, "toc"], "reach": [27, "tocchi"], "gone": [27, "non"]
  },
  "start_pad": 0.25,
  "end_pad": 2.6,
  "default_gap": 0.28,
  "lines": [
    { "id": 1,  "who": "N", "say": "Immagina: sono le ventitré e cinquantotto, e sei il portiere di notte di un motel vuoto.",
      "caps": [["immagina", "IMMAGINA"], ["ventitre", "*23:58"], ["portiere", "PORTIERE DI NOTTE"], ["motel", "MOTEL VUOTO"]] },
    { "id": 2,  "who": "N", "say": "Il proprietario ti passa un biglietto. Quattro regole.",
      "caps": [["proprietario", "IL PROPRIETARIO"], ["biglietto", "UN BIGLIETTO"], ["quattro", "*4 *REGOLE"]] },
    { "id": 3,  "who": "N", "say": "Tieni accesa la luce dell'ufficio fino alle sei del mattino.",
      "caps": [["tieni", "LUCE ACCESA"], ["fino", "FINO ALLE *6"]] },
    { "id": 4,  "who": "N", "say": "La stanza nove non esiste.",
      "caps": [["stanza", "LA *STANZA *9"], ["non", "NON ESISTE"]] },
    { "id": 5,  "who": "N", "say": "Se chiama la stanza nove, lascia squillare.",
      "caps": [["se", "SE CHIAMA LA *9"], ["lascia", "LASCIA SQUILLARE"]] },
    { "id": 6,  "who": "N", "say": "Dopo le tre, non aprire mai la porta.", "gap": 0.45,
      "caps": [["dopo", "DOPO LE *3"], ["non", "*NON APRIRE"], ["porta", "LA PORTA"]] },
    { "id": 7,  "who": "N", "say": "Mezzanotte e trentuno. Entra un cliente, fradicio.",
      "caps": [["mezzanotte", "*00:31"], ["entra", "UN CLIENTE"], ["fradicio", "*FRADICIO"]] },
    { "id": 8,  "who": "N", "say": "Vuole la stanza nove.",
      "caps": [["vuole", "VUOLE"], ["la", "LA *STANZA *9"]] },
    { "id": 9,  "who": "N", "say": "Dici quello che c'è scritto. Siamo al completo.",
      "caps": [["dici", "DICI"], ["siamo", "SIAMO AL *COMPLETO"]] },
    { "id": 10, "who": "N", "say": "Non discute. Esce, e cammina lungo le stanze.",
      "caps": [["non", "NON DISCUTE"], ["esce", "ESCE"], ["cammina", "LUNGO LE STANZE"]] },
    { "id": 11, "who": "N", "say": "E si ferma davanti a una nona porta, che un'ora fa non c'era.", "gap": 0.45,
      "caps": [["si", "SI FERMA"], ["nona", "UNA *NONA PORTA"], ["unora", "UN'ORA FA"], ["non", "NON C'ERA"]] },
    { "id": 12, "who": "N", "say": "Le due e dieci. Si accende il telefono. Stanza nove.",
      "caps": [["le", "*02:10"], ["accende", "SI ACCENDE"], ["stanza", "*STANZA *9"]] },
    { "id": 13, "who": "N", "say": "Lo lasci squillare.",
      "caps": [["lo", "LASCI *SQUILLARE"]] },
    { "id": 14, "who": "N", "say": "Nove squilli. Poi parte la segreteria.",
      "caps": [["nove", "*9 SQUILLI"], ["poi", "POI PARTE"], ["segreteria", "LA SEGRETERIA"]] },
    { "id": 15, "who": "N", "say": "E la voce sul nastro... è la tua.", "gap": 0.45,
      "caps": [["voce", "LA VOCE"], ["e", "È LA *TUA"]] },
    { "id": 16, "who": "YOU", "say": "Non farlo entrare.", "gap": 0.7,
      "caps": [["non", "NON"], ["farlo", "FARLO *ENTRARE"]] },
    { "id": 17, "who": "N", "say": "Le tre e quaranta. La lampada comincia a sfarfallare.",
      "caps": [["le", "*03:40"], ["lampada", "LA LAMPADA"], ["sfarfallare", "*SFARFALLA"]] },
    { "id": 18, "who": "N", "say": "Quando si spegne, sono più vicini.",
      "caps": [["quando", "QUANDO SI *SPEGNE"], ["sono", "PIÙ *VICINI"]] },
    { "id": 19, "who": "N", "say": "Quando resta accesa, indietreggiano.", "gap": 0.4,
      "caps": [["quando", "QUANDO RESTA"], ["indietreggiano", "*INDIETREGGIANO"]] },
    { "id": 20, "who": "N", "say": "Le quattro e quarantaquattro. Un camion prende la curva troppo veloce.", "gap": 0.35,
      "caps": [["le", "*04:44"], ["camion", "UN CAMION"], ["troppo", "TROPPO *VELOCE"]] },
    { "id": 21, "who": "N", "say": "Centra il palo.", "gap": 0.6,
      "caps": [["centra", "*CENTRA"], ["palo", "IL PALO"]] },
    { "id": 22, "who": "N", "say": "E la tua luce si spegne.", "gap": 0.9,
      "caps": [["la", "LA TUA LUCE"], ["si", "SI *SPEGNE"]] },
    { "id": 23, "who": "N", "say": "Toc. Toc.", "gap": 0.35,
      "caps": [["toc", "*TOC"], ["toc", "*TOC"]] },
    { "id": 24, "who": "OWNER", "say": "Sono il proprietario. Ho la benzina per il generatore.",
      "caps": [["sono", "SONO IL *PROPRIETARIO"], ["benzina", "BENZINA"], ["per", "PER IL GENERATORE"]] },
    { "id": 25, "who": "N", "say": "Dallo spioncino: il proprietario, con una tanica.",
      "caps": [["dallo", "DALLO *SPIONCINO"], ["il", "IL PROPRIETARIO"], ["con", "UNA TANICA"]] },
    { "id": 26, "who": "N", "say": "Porta un cappellino rosso.", "gap": 0.5,
      "caps": [["porta", "PORTA UN"], ["cappellino", "*CAPPELLINO *ROSSO"]] },
    { "id": 27, "who": "N", "say": "Ti tocchi la testa. Il tuo non c'è più.", "gap": 0.6,
      "caps": [["ti", "TI TOCCHI"], ["il", "IL TUO"], ["non", "*NON *C'È PIÙ"]] },
    { "id": 28, "who": "N", "say": "Apri la porta e riaccendi la luce? O resti al buio... con loro?", "gap": 0.5,
      "caps": [["apri", "*APRI LA PORTA"], ["riaccendi", "RIACCENDI LA LUCE?"], ["o", "O RESTI"], ["al", "AL *BUIO"], ["con", "CON *LORO?"]] },
    { "id": 29, "who": "N", "say": "Commenta qui sotto. Segui per il giorno due.",
      "caps": [["commenta", "COMMENTA QUI SOTTO"], ["segui", "SEGUI PER IL"], ["giorno", "*GIORNO *2"]] }
  ]
}
